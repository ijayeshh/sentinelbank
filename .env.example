# SentinelBank environment configuration
# Copy to .env and adjust:  Copy-Item .env.example .env
# Defaults here are identical to the defaults in app/config.py.

# =============================================================================
# PostgreSQL 16 + pgvector (runs in Docker; the app itself runs natively)
# =============================================================================

# Host as seen from Windows, not from inside the container.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sentinelbank
POSTGRES_USER=sentinel
# Local-only demo credential. There is no cloud service anywhere in this project.
POSTGRES_PASSWORD=sentinel

# =============================================================================
# LLM serving — Ollama
# =============================================================================

# OpenAI-compatible endpoint. Everything speaks /v1/chat/completions, which keeps a
# future vLLM swap down to changing this one variable (PROJECT_PLAN.md §2).
OLLAMA_BASE_URL=http://localhost:11434/v1

# The custom model built by: ollama create sentinelbank-llm -f Modelfile
# (FROM llama3.2:3b-instruct-q4_K_M — ~2.0 GB of weights, fits the 4 GB card).
OLLAMA_MODEL=sentinelbank-llm

# Context window. NEVER raise this. Defaulting to the model's max context is the
# single most common cause of OOM on a 4 GB card (§1.1 rule 2). If flash attention
# turns out to be unsupported on this Turing GPU, drop to 2048 and record the
# deviation in README.md rather than raising anything else.
LLM_NUM_CTX=4096

# Determinism is a hard requirement — the red-team harness asserts against specific
# responses, so this stays low (§6 rule 3).
LLM_TEMPERATURE=0.1

# =============================================================================
# Guardrail models (all run on CPU, device=-1 — only Ollama touches the GPU)
# =============================================================================

# Prompt-injection classifier. meta-llama/Prompt-Guard-86M is a GATED repo: accept
# the license on Hugging Face and run `huggingface-cli login` first. If it cannot be
# loaded, the app falls back to the ungated model below and logs a clear warning —
# set this explicitly to the fallback to skip the gated path entirely (§1.1 step 5):
#   INJECTION_MODEL_ID=protectai/deberta-v3-base-prompt-injection-v2
INJECTION_MODEL_ID=meta-llama/Prompt-Guard-86M

# Score at or above which input (or a retrieved UNTRUSTED field) is treated as an
# injection attempt. Lower = more sensitive = higher false-positive rate, which the
# benign half of the red-team set measures (§4.3).
INJECTION_THRESHOLD=0.8

# Sentence embedding model for policy-document RAG. 384 dimensions, matching the
# vector(384) column in policy_chunks. Loaded once as a module-level singleton.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# =============================================================================
# Session
# =============================================================================

# The RM whose portfolio is in scope, and the owner of all six poisoned demo rows.
# This is application session state: rm_id is NEVER taken from model output or from
# user text, because entitlement is an application-layer decision (§2.1, §6 rule 5).
DEFAULT_RM_ID=RM-001

# =============================================================================
# GUARDRAILS_ENABLED — one flag per middleware in the §3.4 stack
# =============================================================================
# The core demo is toggling these off and on, so every rail is individually
# switchable. These are also mutable at runtime via POST /config/rails and the
# Streamlit sidebar checkboxes; the values here are only the startup defaults.
# Listed in execution order. All default to true — absent config means rails ON.

# 1. Scans user input before the agent runs; can jump straight to end.
GUARDRAILS_ENABLED__INJECTION_INPUT=true

# 2. LangChain PIIMiddleware built-ins: email and credit_card (Luhn-validated).
GUARDRAILS_ENABLED__PII_BUILTIN=true

# 3. Presidio via PIIMiddleware's `detector` hook: SSN, bank number, driver's
#    licence, phone, location, DOB, and the custom ABA routing recognizer.
GUARDRAILS_ENABLED__PII_PRESIDIO=true

# 4. Reversible person pseudonymization (Michael Chen -> <PERSON_a3f9>). The map
#    lives in per-request state only and is cleared at request end.
GUARDRAILS_ENABLED__PERSON_PSEUDONYM=true

# 5. Human-in-the-loop risk tiers. Turning this off does NOT enable HARD_BLOCK
#    tools — an OFAC-flagged wire is refused regardless of any approval.
GUARDRAILS_ENABLED__HITL=true

# 6. Scans UNTRUSTED tool-result fields (description, notes, merchant) before they
#    reach model context. This is the signature rail of the whole project (§3.2.2).
GUARDRAILS_ENABLED__INJECTION_TOOL_RESULT=true

# 7. Wraps untrusted retrieved data in <untrusted_bank_data> delimiters, having
#    first stripped those delimiters from the content itself (§3.2.3).
GUARDRAILS_ENABLED__SPOTLIGHT=true

# 8. Writes the SHA-256 hash-chained audit entry. Disabling this breaks chain
#    continuity for the requests it skips — expected, and part of the demo.
GUARDRAILS_ENABLED__AUDIT=true
