# --- Python virtual environment --------------------------------------------
.venv/
venv/
env/

# --- Python bytecode and build artifacts -----------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# --- Secrets ----------------------------------------------------------------
# .env holds local credentials and rail toggles; .env.example is committed instead.
.env

# --- Local databases and agent state ----------------------------------------
*.db
*.sqlite
*.sqlite3
# LangGraph checkpointer backing the HITL interrupts (§3.3). SQLite's write-ahead log
# and shared-memory sidecars are separate files and are NOT matched by *.db.
checkpoints.db
*.db-shm
*.db-wal

# --- Postgres volume data (if bind-mounted instead of a named volume) -------
pgdata/
postgres-data/
db/data/

# --- Generated red-team output ----------------------------------------------
# latency.jsonl is a raw append-only sample log that grows on every run — a build
# artifact, not a deliverable.
redteam/latency.jsonl
# results.jsonl is one row per case from the last `pytest redteam/` run. Committed:
# report.py consumes it, and it is the evidence behind the numbers in RESULTS.md.
#
# RESULTS.md is deliberately NOT ignored. §4.3 calls it a deliverable and README.md
# links to it, so ignoring it left a fresh clone with a broken link to the one file
# that carries the measured rail-effectiveness and latency tables.

# --- Model / tooling caches -------------------------------------------------
.cache/
.huggingface/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Windows / editor noise -------------------------------------------------
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
